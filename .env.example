# Copy to .env and `source .env`, or export these in your shell.
export ANTHROPIC_API_KEY=            # reader for real photos + the front desk agent
export LOBSTA_PROFILE=sushi          # default restaurant (configs/<name>.json); ?p=hotpot switches in the browser
export LOBSTA_READER=                # anthropic | local | mock   (blank = anthropic if the key is set, else mock)
export LOBSTA_API_MODEL=claude-sonnet-5-5
export LOBSTA_CHAT_MODEL=claude-haiku-5-5
export LOBSTA_CHAT=agent             # agent | rules  (rules = no API, keyword matching)
export LOBSTA_LOCAL_URL=http://localhost:8000/v1   # your fine-tuned model (train/serve_local.py)
export LOBSTA_SHEET_ID=              # Google Sheet to mirror into (optional)
export GOOGLE_APPLICATION_CREDENTIALS=service-account.json
export LOBSTA_TODAY=                 # YYYY-MM-DD, pin "today" for a rehearsal (blank = real date)
